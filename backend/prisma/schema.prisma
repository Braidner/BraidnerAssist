generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Локальная задача (источник "local"). GitLab-задачи не хранятся в БД —
// они подтягиваются на лету и сливаются с локальными в Tasks Hub.
model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String    @default("todo") // todo | in_progress | done
  priority    String    @default("medium") // low | medium | high
  dueDate     DateTime?
  source      String    @default("local") // local (GitLab проксируется отдельно)
  claimedBy   String?   // кто взял задачу в работу, напр. "hermes"
  claimedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Лог действий агента Hermes (через MCP log_action).
model AgentLog {
  id        String   @id @default(cuid())
  action    String
  details   String?
  result    String?
  taskId    String?  // привязка записи лога к конкретной задаче (Task.id)
  createdAt DateTime @default(now())
}

// Очередь команд агенту + его задачи (active/done).
model AgentTask {
  id          String    @id @default(cuid())
  command     String
  payload     String? // JSON-строка
  status      String    @default("queued") // queued | active | done | error
  result      String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?
}

// Текущий статус агента (single-row, обновляется report_status).
model AgentStatus {
  id        Int      @id @default(1)
  status    String   @default("idle") // active | idle | error
  message   String?
  updatedAt DateTime @updatedAt
}

// Сессии Hermes-агента: переписка с LLM, хранится локально (сервер не даёт GET по ID).
model HermesSession {
  id               String   @id @default(cuid())
  title            String
  latestResponseId String?  // ID последнего ответа от /v1/responses
  messages         String   @default("[]") // JSON: [{role,text}]
  status           String   @default("idle") // running | idle | error
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// История аптайма сервисов (пишется сэмплером каждые POLL_SERVICES мс).
model ServiceCheck {
  id        String   @id @default(cuid())
  name      String
  status    String   // ok | warn | bad
  latencyMs Int?     // null при timeout/error
  createdAt DateTime @default(now())

  @@index([name, createdAt])
}

// Media v2: привязка торрент → контент. Качаем пофайлово через qBittorrent
// (filePrio), чтобы тянуть только выбранные серии. Один торрент на тайтл —
// позже докачиваем ещё серии/сезон, меняя приоритет файлов (без re-add).
model MediaTorrent {
  id          String             @id @default(cuid())
  contentType String             // movie | series
  tmdbId      Int?
  tvdbId      Int?
  title       String
  infohash    String             @unique // qB/TorrServer hash (lowercase hex)
  magnet      String?
  savePath    String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  files       MediaTorrentFile[]
}

// Файл внутри торрента + его маппинг на серию (распарсенный из имени).
// wanted=true → качаем (qB prio>0); false → пропущен (prio 0).
model MediaTorrentFile {
  id            String       @id @default(cuid())
  torrentId     String
  torrent       MediaTorrent @relation(fields: [torrentId], references: [id], onDelete: Cascade)
  fileIndex     Int
  path          String
  length        Float        @default(0) // байты (Float — чтобы влезли файлы > 2 ГБ)
  wanted        Boolean      @default(false)
  seasonNumber  Int?
  episodeNumber Int?

  @@unique([torrentId, fileIndex])
}

// Локальные предпочтения discovery-каталога. Это состояние только дашборда:
// не Jellyfin favorites и не команды Radarr/Sonarr.
model MediaPreference {
  id        String   @id @default(cuid())
  kind      String   // movie | series
  tmdbId    Int
  tvdbId    Int?
  status    String   // watchlist | hidden | liked | disliked
  title     String
  poster    String?
  backdrop  String?
  year      Int?
  overview  String?
  rating    Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([kind, tmdbId])
  @@index([status, updatedAt])
}

// Локальные события календаря (если нет CalDAV).
model CalendarEvent {
  id          String   @id @default(cuid())
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime?
  location    String?
  source      String   @default("local") // local | caldav | ics
  createdAt   DateTime @default(now())
}

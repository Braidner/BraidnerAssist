generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AppUser {
  id           String   @id @default(cuid())
  username     String   @unique
  displayName  String?
  passwordHash String
  role         String   @default("media") // admin | media
  jellyfinUserId String?
  jellyfinAccessToken String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([jellyfinUserId])
}

// Локальная задача (источник "local"). GitLab-задачи не хранятся в БД —
// они подтягиваются на лету и сливаются с локальными в Tasks Hub.
model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String    @default("todo") // todo | in_progress | done
  priority    String    @default("medium") // low | medium | high
  dueDate     DateTime?
  source      String    @default("local") // local (GitLab проксируется отдельно)
  claimedBy   String?   // кто взял задачу в работу, напр. "hermes"
  claimedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Лог действий агента Hermes (через MCP log_action).
model AgentLog {
  id        String   @id @default(cuid())
  action    String
  details   String?
  result    String?
  taskId    String?  // привязка записи лога к конкретной задаче (Task.id)
  createdAt DateTime @default(now())
}

// Очередь команд агенту + его задачи (active/done).
model AgentTask {
  id          String    @id @default(cuid())
  command     String
  payload     String? // JSON-строка
  status      String    @default("queued") // queued | active | done | error
  result      String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?
}

// Текущий статус агента (single-row, обновляется report_status).
model AgentStatus {
  id        Int      @id @default(1)
  status    String   @default("idle") // active | idle | error
  message   String?
  updatedAt DateTime @updatedAt
}

// Сессии Hermes-агента: переписка с LLM, хранится локально (сервер не даёт GET по ID).
model HermesSession {
  id               String   @id @default(cuid())
  title            String
  latestResponseId String?  // ID последнего ответа от /v1/responses
  messages         String   @default("[]") // JSON: [{role,text}]
  status           String   @default("idle") // running | idle | error
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// История аптайма сервисов (пишется сэмплером каждые POLL_SERVICES мс).
model ServiceCheck {
  id        String   @id @default(cuid())
  name      String
  status    String   // ok | warn | bad
  latencyMs Int?     // null при timeout/error
  createdAt DateTime @default(now())

  @@index([name, createdAt])
}

// Lightweight media registry: выбранный TMDB title ↔ выбранный торрент ↔ Jellyfin item.
// Это не monitor/missing queue: qB качает сразу в movies/tv, Jellyfin сам каталогизирует.
model MediaTitle {
  id        String   @id @default(cuid())
  kind      String   // movie | series
  tmdbId    Int
  tvdbId    Int?
  title     String
  year      Int?
  poster    String?
  backdrop  String?
  overview  String?
  jellyfinId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  torrents  MediaTorrent[]

  @@unique([kind, tmdbId])
  @@index([jellyfinId])
}

model MediaTorrent {
  id           String     @id @default(cuid())
  titleId      String
  title        MediaTitle @relation(fields: [titleId], references: [id], onDelete: Cascade)
  infohash     String     @unique
  releaseTitle String
  releaseUrl   String?
  guid         String?
  indexer      String?
  size         Float?
  seeders      Int?
  savePath     String?
  category     String?    @default("mc-library")
  seasonNumber Int?
  addedAt      DateTime   @default(now())
  completedAt  DateTime?
  lastSeenAt   DateTime?
  state        String?
  progress     Float      @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([titleId, updatedAt])
  @@index([progress, updatedAt])
}

model MediaReleaseDetailCache {
  id        String   @id @default(cuid())
  provider  String
  url       String   @unique
  payload   String   @default("{}") // JSON payload from tracker detail parser
  lastError String?
  fetchedAt DateTime @default(now())
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([provider, expiresAt])
}

// Локальные предпочтения discovery-каталога. Это состояние только дашборда:
// не Jellyfin favorites и не команды Radarr/Sonarr.
model MediaPreference {
  id        String   @id @default(cuid())
  appUserId String   @default("global")
  kind      String   // movie | series
  tmdbId    Int
  tvdbId    Int?
  status    String   // watchlist | hidden | liked | disliked
  title     String
  poster    String?
  backdrop  String?
  year      Int?
  overview  String?
  rating    Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([appUserId, kind, tmdbId])
  @@index([appUserId, status, updatedAt])
  @@index([status, updatedAt])
}

// Локальные события календаря (если нет CalDAV).
model CalendarEvent {
  id          String   @id @default(cuid())
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime?
  location    String?
  source      String   @default("local") // local | caldav | ics
  createdAt   DateTime @default(now())
}

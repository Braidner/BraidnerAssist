# ─── GitLab (self-hosted) ───────────────────────────────────────────
GITLAB_URL=http://your-gitlab.local
GITLAB_TOKEN=                    # Personal Access Token, scopes: api, read_api
GITLAB_USER_ID=                  # GET /api/v4/user → поле "id"

# ─── Home Assistant ─────────────────────────────────────────────────
HASS_URL=http://homeassistant.local:8123
HASS_TOKEN=                      # Profile → Security → Long-Lived Access Tokens

# ─── Hermes Agent (Nous Research API server) ────────────────────────
# Из контейнера backend 127.0.0.1 указывает на сам контейнер — задавай
# LAN-адрес хоста или host.docker.internal (см. docker-compose.prod.yml).
HERMES_URL=http://127.0.0.1:8000  # vllm-mlx inference server (uses /v1/responses)
HERMES_API_KEY=                  # optional; only needed if server requires auth
HERMES_MODEL=default             # model name as reported by /v1/models

# ─── Weather (Open-Meteo — без ключа, только координаты) ─────────────
WEATHER_LAT=55.7558
WEATHER_LON=37.6173

# ─── Proxmox VE (опц.) ──────────────────────────────────────────────
# API-токен: Datacenter → Permissions → API Tokens (нужны права PVEAuditor).
# Self-signed cert игнорируется автоматически.
PROXMOX_URL=https://192.168.x.x:8006
PROXMOX_TOKEN=                    # user@pam!mc=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PROXMOX_NODE=                     # опционально; если пусто — первый online-нод

# ─── Calendar (CalDAV — опц.) ───────────────────────────────────────
CALDAV_URL=
CALDAV_USERNAME=
CALDAV_PASSWORD=

# ─── Homelab Services (HTTP healthcheck) ────────────────────────────
# JSON файл: [{ "name": "...", "url": "http://..." }, ...]
# Если файл отсутствует — панель показывает мок-данные.
SERVICES_FILE=/data/services.json

# ─── Apple Health Export ────────────────────────────────────────────
HEALTH_EXPORT_PATH=/data/health/export.xml

# ─── Auth ───────────────────────────────────────────────────────────
AUTH_USER=braidner
# bcrypt hash пароля. Сгенерировать: node -e "require('bcryptjs').hash('пароль',10).then(console.log)"
AUTH_PASSWORD_HASH=$2b$10$e7soZessyEaSqsCVB3tAc.uHMPOqPAo7wQvBs765ozxzq0L3dfZG.
JWT_SECRET=                      # сгенерировать: openssl rand -hex 32
APP_TOKEN=                       # статический токен для iOS Shortcuts / Hermes (openssl rand -hex 20)

# ─── App ────────────────────────────────────────────────────────────
BACKEND_PORT=3001                # backend API + MCP (Streamable HTTP)
FRONTEND_PORT=3000               # frontend (nginx)
MCP_TOKEN=                       # bearer-токен для MCP HTTP транспорта (Phase 5)
NODE_ENV=production

# Для backend внутри контейнера (не меняй без причины)
DATABASE_URL=file:/data/mission-control.db

# ─── Docker Engine API (опц.) ────────────────────────────────────────
# ВНИМАНИЕ: docker.sock = root-эквивалент на хосте. Opt-in; без этой переменной
# блок Docker показывает «Not configured».
# DOCKER_SOCKET=/var/run/docker.sock

# ─── Нотификации через ntfy (опц.) ───────────────────────────────────
# Hermes шлёт push при переходе в статус error.
# NTFY_URL=https://ntfy.sh/<your-secret-topic>

# ─── AdGuard Home — DNS-статистика (опц.) ────────────────────────────
# Из контейнера backend используй host.docker.internal для сервисов на хосте.
# ADGUARD_URL=http://host.docker.internal:8053
# ADGUARD_USER=admin
# ADGUARD_PASSWORD=

# ─── Медиа-стек (опц.) ───────────────────────────────────────────────
# Каждый источник независим; панель /media активна если задан хотя бы один.
# JELLYFIN_URL=http://host.docker.internal:8096
# JELLYFIN_API_KEY=                # Dashboard → API Keys
# SONARR_URL=http://host.docker.internal:8989
# SONARR_API_KEY=                  # Settings → General → API Key
# RADARR_URL=http://host.docker.internal:7878
# RADARR_API_KEY=
# QBITTORRENT_URL=http://host.docker.internal:8080
# QBITTORRENT_USER=admin
# QBITTORRENT_PASSWORD=
# PROWLARR_URL=http://host.docker.internal:9696   # поиск релизов (Settings → General → API Key)
# PROWLARR_API_KEY=
# TORRSERVER_URL=http://host.docker.internal:8090  # мгновенный стриминг магнета (YouROK TorrServer)
# TORRSERVER_USER=                 # опц. basic-auth (если включён в TorrServer)
# TORRSERVER_PASSWORD=
# TMDB_API_KEY=                    # Media v2: метаданные/дискавери напрямую (themoviedb.org → Settings → API → v3 key)
# Media v2 (Фаза 3): файл-браузер + органайзер «торрент→библиотека».
# MEDIA_HOST_PATH — путь медиатеки на ХОСТЕ (монтируется в backend как /media); на hermes.lan = /srv/stack/media.
# MEDIA_ROOT задаётся в docker-compose.prod.yml (=/media). Подпапки переопределяемы (дефолт downloads/tv/movies).
# MEDIA_HOST_PATH=/srv/stack/media
# MEDIA_DOWNLOADS=downloads
# MEDIA_TV=tv
# MEDIA_MOVIES=movies

# ─── Polling интервалы (мс) ─────────────────────────────────────────
POLL_SERVICES=60000
POLL_WEATHER=1800000
POLL_TASKS=300000
POLL_PROXMOX=30000

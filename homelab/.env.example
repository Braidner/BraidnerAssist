# Homelab stack env. Скопировать в /srv/stack/.env на сервере.
# PUID/PGID — id пользователя, владеющего ./*/config и ./media. На
# hermes.lan это `braidner` (uid 1000, gid 1000) — проверить `id braidner`.
PUID=1000
PGID=1000
TZ=Europe/Moscow

# Samba-шара /srv/stack/llm (smb://hermes.lan/llm, юзер braidner).
# Сгенерировать: openssl rand -base64 18
SAMBA_PASSWORD=
